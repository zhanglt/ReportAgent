  "schema_data": "【DB_ID】 \n【Schema】\n# Table: businessdb.ST_TABLE_D, 表结构字典\n[\n(TABID:VARCHAR, 表标识，即业务表名, Primary Key),\n(TABNO:VARCHAR, 表编号),\n(TABCN:VARCHAR, 表中文名称),\n(TABEN:VARCHAR, 表英文名称),\n(EXCHFL:CHAR, 交换标志),\n(MODITIME:DATETIME, 最新修改时间)\n]\n# Table: businessdb.ST_PPTN_R, 降水量\n[\n(STCD:CHAR, 测站编码, Primary Key),\n(TM:DATETIME, 降水量截止时间, Primary Key),\n(DRP:DECIMAL, 时段降水量，mm),\n(INTV:DECIMAL, 时段长，HH.NN，NN 表示分钟而非十进制小时),\n(PDR:DECIMAL, 降水历时，HH.NN),\n(DYP:DECIMAL, 日降水量，mm),\n(WTH:CHAR, 天气：5雪、6雨夹雪、7雨、8阴、9晴),\n(GGMD:CHAR, 观测方式：0或空为自动，1为人工，补充自字段文档)\n]\n# Table: businessdb.ST_FORECAST_F, 水情预报成果\n[\n(STCD:CHAR, 测站编码, Primary Key),\n(UNITNAME:VARCHAR, 预报单位名称, Primary Key),\n(PLCD:VARCHAR, 预报方案或发布标识，按业务约定填写, Primary Key),\n(FYMDH:DATETIME, 依据时间, Primary Key),\n(IYMDH:DATETIME, 发布时间, Primary Key),\n(YMDH:DATETIME, 预报发生时间, Primary Key),\n(Z:DECIMAL, 预报水位，m),\n(Q:DECIMAL, 预报流量，m3/s)\n]\n# Table: businessdb.ST_FIELD_D, 字段结构字典\n[\n(TABID:VARCHAR, 所属表标识, Primary Key),\n(FLID:VARCHAR, 字段标识，即字段名, Primary Key),\n(FLSID:DECIMAL, 字段顺序号),\n(FLCN:VARCHAR, 字段中文名称),\n(FLEN:VARCHAR, 字段英文名称),\n(FLTL:VARCHAR, 字段类型及长度描述),\n(NLAT:CHAR, 空值属性标志),\n(UNNM:VARCHAR, 计量单位名称),\n(FCHSC:VARCHAR, 字段取值范围描述),\n(EUFL:CHAR, 交换使用标志),\n(PKAT:CHAR, 主键属性或主键顺序标志),\n(MODITIME:DATETIME, 最新修改时间)\n]\n# Table: businessdb.ST_ADDVCD_D, 行政区域代码\n[\n(ADDVCD:CHAR, 行政区划代码，保留前导零, Primary Key),\n(ADDVNM:VARCHAR, 行政区划名称),\n(COMMENTS:VARCHAR, 备注),\n(MODITIME:DATETIME, 最新修改时间)\n]\n# Table: businessdb.ST_RVFCCH_B, 河道站防洪指标\n[\n(STCD:CHAR, 测站编码, Primary Key),\n(LDKEL:DECIMAL, 左岸堤顶高程，m),\n(RDKEL:DECIMAL, 右岸堤顶高程，m),\n(WRZ:DECIMAL, 警戒水位，m),\n(WRQ:DECIMAL, 警戒流量，m3/s),\n(GRZ:DECIMAL, 保证水位，m),\n(GRQ:DECIMAL, 保证流量，m3/s),\n(FLPQ:DECIMAL, 平滩流量，m3/s),\n(OBHTZ:DECIMAL, 实测最高水位，m),\n(OBHTZTM:DATETIME, 实测最高水位发生时间),\n(IVHZ:DECIMAL, 调查最高水位，m),\n(IVHZTM:DATETIME, 调查最高水位发生时间),\n(OBMXQ:DECIMAL, 实测最大流量，m3/s),\n(OBMXQTM:DATETIME, 实测最大流量发生时间),\n(IVMXQ:DECIMAL, 调查最大流量，m3/s),\n(IVMXQTM:DATETIME, 调查最大流量发生时间),\n(HMXS:DECIMAL, 历史最大含沙量，kg/m3),\n(HMXSTM:DATETIME, 历史最大含沙量发生时间),\n(HMXAVV:DECIMAL, 历史最大断面平均流速，m/s),\n(HMXAVVTM:DATETIME, 历史最大断面平均流速发生时间),\n(HLZ:DECIMAL, 历史最低水位，m),\n(HLZTM:DATETIME, 历史最低水位发生时间),\n(HMNQ:DECIMAL, 历史最小流量，m3/s),\n(HMNQTM:DATETIME, 历史最小流量发生时间),\n(TAZ:DECIMAL, 多年平均水位，m),\n(TAQ:DECIMAL, 多年平均流量，m3/s),\n(LAZ:DECIMAL, 多年平均最低水位，m),\n(LAQ:DECIMAL, 多年平均最小流量，m3/s),\n(SFZ:DECIMAL, 安全泄量相应水位，m),\n(SFQ:DECIMAL, 安全泄量，m3/s),\n(MODITIME:DATETIME, 最新修改时间)\n]\n# Table: businessdb.ST_RIVER_R, 河道水情\n[\n(STCD:CHAR, 测站编码, Primary Key),\n(TM:DATETIME, 水情发生时间, Primary Key),\n(Z:DECIMAL, 水位，m),\n(Q:DECIMAL, 流量，m3/s),\n(XSA:DECIMAL, 断面过水面积，m2),\n(XSAVV:DECIMAL, 断面平均流速，m/s),\n(XSMXV:DECIMAL, 断面最大流速，m/s),\n(FLWCHRCD:CHAR, 水情特征：1干涸、2断流、3流向不定、4逆流、5起涨、6洪峰),\n(WPTN:CHAR, 水势代码),\n(MSQMT:CHAR, 流量测法代码),\n(MSAMT:CHAR, 面积测法代码),\n(MSVMT:CHAR, 流速测法代码)\n]\n# Table: businessdb.ST_STBPRP_B, 测站基本属性\n[\n(STCD:CHAR, 测站编码, Primary Key),\n(STNM:VARCHAR, 测站名称),\n(RVNM:VARCHAR, 河流名称),\n(HNNM:VARCHAR, 水系名称),\n(BSNM:VARCHAR, 流域名称),\n(LGTD:DECIMAL, 经度，度),\n(LTTD:DECIMAL, 纬度，度),\n(STLC:VARCHAR, 站址),\n(ADDVCD:CHAR, 行政区划代码，未知时填 NULL),\n(DTMNM:VARCHAR, 基面名称),\n(DTMEL:DECIMAL, 基面高程，m),\n(DTPR:DECIMAL, 基面修正值，m),\n(STTP:CHAR, 测站类型代码),\n(FRGRD:CHAR, 报汛等级代码),\n(ESSTYM:CHAR, 建站年月，YYYYMM),\n(BGFRYM:CHAR, 始报年月，YYYYMM),\n(ATCUNIT:VARCHAR, 隶属单位),\n(ADMAUTH:VARCHAR, 管理单位),\n(LOCALITY:VARCHAR, 地方管理或归属信息),\n(STBK:CHAR, 测站岸别代码),\n(STAZT:DECIMAL, 测站方位，度),\n(DSTRVM:DECIMAL, 至河口距离，km),\n(DRNA:DECIMAL, 集水面积，km2),\n(PHCD:VARCHAR, 地形代码),\n(USFL:CHAR, 使用标志),\n(COMMENTS:VARCHAR, 备注),\n(MODITIME:DATETIME, 最新修改时间),\n(RVCD:VARCHAR, 河流代码，补充自字段文档)\n]\n# Table: businessdb.ST_HIWRCH_B, 水情预警指标\n[\n(STCD:CHAR, 测站编码, Primary Key),\n(HIWRTY:CHAR, 预警类型：0洪水、1干旱, Primary Key),\n(HIWRCH:CHAR, 预警指标：0水位、1流量、2水量, Primary Key),\n(WRSTAATR:CHAR, 统计标志：00瞬时、01一天、10十天),\n(BUWR:DECIMAL, 蓝色预警阈值；单位随指标为m、m3/s或m3),\n(YEWR:DECIMAL, 黄色预警阈值),\n(OGWR:DECIMAL, 橙色预警阈值),\n(RDWR:DECIMAL, 红色预警阈值),\n(MODITIME:DATETIME, 最新修改时间，不使用 SQL Server rowversion)\n]\n【Foreign keys】\nST_PPTN_R.STCD=ST_STBPRP_B.STCD\nST_FORECAST_F.STCD=ST_STBPRP_B.STCD\nST_FIELD_D.TABID=ST_TABLE_D.TABID\nST_RVFCCH_B.STCD=ST_STBPRP_B.STCD\nST_RIVER_R.STCD=ST_STBPRP_B.STCD\nST_STBPRP_B.ADDVCD=ST_ADDVCD_D.ADDVCD\nST_HIWRCH_B.STCD=ST_STBPRP_B.STCD",
